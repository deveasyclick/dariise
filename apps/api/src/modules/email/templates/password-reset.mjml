<mjml>
  <mj-head>
    <mj-title>Reset your password</mj-title>
    <mj-preview>Reset your Dariise password — the link expires in {{expiresInMinutes}} minutes.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text color="#3f3f46" font-size="15px" line-height="24px" />
      <mj-button background-color="#18181b" color="#fafafa" font-size="15px" font-weight="600" border-radius="8px" inner-padding="12px 24px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f5" width="480px">
    <mj-section background-color="#ffffff" border="1px solid #e4e4e7" border-radius="12px" padding="32px">
      <mj-column>
        <mj-text font-size="13px" font-weight="700" letter-spacing="0.08em" text-transform="uppercase" color="#71717a" padding-bottom="24px">Dariise</mj-text>
        <mj-text font-size="20px" line-height="28px" color="#18181b" font-weight="700" padding-bottom="16px">Reset your password</mj-text>
        <mj-text padding-bottom="16px">{{greeting}}</mj-text>
        <mj-text padding-bottom="16px">We received a request to reset the password for your Dariise account. Choose a new password using the button below.</mj-text>
        <mj-button href="{{url}}" padding="8px 0 24px">Choose a new password</mj-button>
        <mj-text font-size="13px" line-height="20px" color="#71717a" padding-bottom="4px">If the button does not work, copy this link into your browser:</mj-text>
        <mj-text font-size="13px" line-height="20px" padding-bottom="24px"><a href="{{url}}" style="color:#2563eb;word-break:break-all;">{{url}}</a></mj-text>
        <mj-divider border-color="#e4e4e7" padding="0 0 16px" />
        <mj-text font-size="13px" line-height="20px" color="#71717a">This link can be used once and expires in {{expiresInMinutes}} minutes. If you did not request a password reset, you can ignore this email — your password will not change.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
